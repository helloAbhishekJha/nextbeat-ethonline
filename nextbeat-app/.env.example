# NextBeat environment — Hedera TESTNET only. Never commit real keys.

# Agent (payer) — ECDSA testnet account
HEDERA_AGENT_ACCOUNT_ID=0.0.XXXXX
HEDERA_AGENT_PRIVATE_KEY=0x...

# Service (payTo / HCS operator)
HEDERA_SERVICE_ACCOUNT_ID=0.0.YYYYY
HEDERA_SERVICE_PRIVATE_KEY=0x...

# Price floor in tinybars (1 HBAR = 100_000_000). Default 1000 = 0.00001 HBAR.
PAYCALL_PRICE_TINYBARS=1000
# Hard cap so a bad quote cannot drain the agent (0.001 HBAR).
PAYCALL_PRICE_CAP_TINYBARS=100000
# Agent session spend ceiling (tinybars).
PAYCALL_BUDGET_TINYBARS=5000000

PORT=4021
AGENT_PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

X402_TESTNET_FACILITATOR_URL=https://api.testnet.blocky402.com
SERVICE_PUBLIC_URL=http://127.0.0.1:4021
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# Two live Graph HTTP query endpoints (Studio or gateway), comma-separated.
# Required for The Graph prize. Example: Studio deployment URLs.
# GRAPH_QUERY_URLS=https://api.studio.thegraph.com/query/<id>/uniswap-v3/version/latest,https://api.studio.thegraph.com/query/<id>/aave-v3/version/latest
GRAPH_QUERY_URLS=
GRAPH_API_KEY=

# Optional HCS topic for audit receipts. Create once: npm run create-topic -w @nextbeat/service
HCS_TOPIC_ID=
