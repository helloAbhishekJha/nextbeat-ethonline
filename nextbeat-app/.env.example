# Hedera testnet — two ECDSA accounts from portal.hedera.com (never mainnet)
# Account ID = digits only, e.g. 0.0.6154321 (NOT 0.0.XXXXX)
# Private key = full DER hex from portal (long string starting with 302e..., NOT "302e...")
HEDERA_SERVICE_ACCOUNT_ID=
HEDERA_SERVICE_PRIVATE_KEY=
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=

# Metered brief price (default 1000 tinybars = 0.00001 HBAR)
PAYCALL_PRICE_TINYBARS=1000
PAYCALL_BUDGET_TINYBARS=5000000

# Local dev URLs
SERVICE_PUBLIC_URL=http://127.0.0.1:4021

# The Graph (slot 2) — comma-separated Studio/gateway query URLs
# GRAPH_QUERY_URLS=https://gateway.thegraph.com/api/.../subgraphs/id/...,https://...
# GRAPH_API_KEY=

# Slot 3 sponsor: world | ens | bazantic | none
SLOT_3_SPONSOR=world

# World Selfie Check (slot 3 pilot) — Developer Portal app_id + rp_id + RP signing key
# WORLD_APP_ID=app_...
# WORLD_RP_ID=rp_...
# WORLD_ACTION=nextbeat-desk
# WORLD_SIGNING_KEY_HEX=0x...

# Local testing without World portal credentials (clearly dev-only)
WORLD_DEMO_GATE=true

# Desk UI: classic = Treasury Risk Desk (submission) | simple = beta copy at /simple locally
DESK_UI=classic

# LLM reasoning (Graph-grounded beat synthesis) — pick one:
# Groq (fastest for Vercel): https://console.groq.com
# GROQ_API_KEY=
# OpenAI fallback:
# OPENAI_API_KEY=
# Hedera x402 inference PoC pattern — LM Studio local OpenAI-compatible server:
# LLM_BASE_URL=http://127.0.0.1:1234
# LLM_MODEL=your-model-name
# LLM_API_KEY=lm-studio
# BLOCKY402_FACILITATOR_ACCOUNT_ID=0.0.7162784
